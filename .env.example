# FleetFlow Environment Configuration

# Application
PROJECT_NAME="FleetFlow"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL 18)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fleetflow"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security & JWT
SECRET_KEY="fleetflow-super-secret-jwt-key-replace-in-production-random-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Sustainability Parameters (Emissions Factors in kg CO2 per unit)
EMISSIONS_FACTOR_DIESEL=2.68
EMISSIONS_FACTOR_PETROL=2.31
EMISSIONS_FACTOR_ELECTRIC=0.45
EMISSIONS_FACTOR_HYBRID=1.85

# Data Storage & Azure Blob Storage (Optional Cloud Integration)
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./data/storage"
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_CONTAINER_NAME="fleetflow-analytics"

# AI / ML Configuration
ML_MODEL_DIR="./models/saved"
FUEL_ANOMALY_CONTAMINATION=0.05
